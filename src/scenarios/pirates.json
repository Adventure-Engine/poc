    { "id": "s_start", "event": { "type": "dialog", "speaker": "Капитан Морган", "text": "Юнга! Я капитан Морган. Мой клад спрятан в этом парке. Собери карту из трёх частей — и сокровище твоё. В путь!" } },
    { "id": "s_oak", "locationId": "loc_old_oak", "reward": ["map_piece_1"], "mapDigit": "7", "event": { "type": "riddle", "speaker": "Капитан Морган", "question": "Капитан спрашивает: сколько дней в неделе?", "answer": "7", "hint": "Понедельник, вторник… и так до воскресенья." } },
    { "id": "s_stones", "locationId": "loc_three_stones", "reward": ["map_piece_2"], "mapDigit": "2", "event": { "type": "riddle", "speaker": "Капитан Морган", "question": "Сколько камней стерегут клад? Посчитай: 🪨 🪨 🪨", "answer": "3", "hint": "Считай камни прямо в вопросе." } },
    { "id": "s_well", "locationId": "loc_well", "reward": ["rusty_key"], "event": { "type": "riddle", "speaker": "Капитан Морган", "question": "Сколько букв в слове «КОЛОДЕЦ»?", "answer": "7", "hint": "К-О-Л-О-Д-Е-Ц — считай по одной." } },
    { "id": "s_open_chest", "locationId": "loc_three_stones", "requires": ["rusty_key"], "reward": ["hook", "map_piece_3"], "mapDigit": "4", "arriveText": "Ты вернулся к трём камням. В руке — ржавый ключ.", "event": { "type": "use_item", "item": "rusty_key", "text": "Ключ поворачивается со скрипом... Сундучок открыт! Внутри крюк и последняя часть карты — на ней третья цифра кода. Карта собрана!" } },
    { "id": "s_ravine", "locationId": "loc_ravine", "event": { "type": "dialog", "speaker": "Капитан Морган", "text": "Перед тобой овраг. Чтобы перебраться, нужна кошка — крюк есть, осталось найти верёвку." } },
    { "id": "s_pine", "locationId": "loc_old_pine", "reward": ["rope"], "event": { "type": "riddle", "speaker": "Капитан Морган", "question": "Чтобы сосна отдала верёвку, ответь пирату: «да».", "answer": "да", "hint": "Просто напиши: да" } },
    { "id": "s_craft", "event": { "type": "craft", "recipeId": "grapnel", "text": "Соедини верёвку и крюк, чтобы получить кошку." } },
    { "id": "s_cross", "locationId": "loc_ravine", "requires": ["grapnel"], "arriveText": "Снова овраг. Теперь у тебя есть кошка!", "event": { "type": "use_item", "item": "grapnel", "text": "Ты забрасываешь кошку и перебираешься через овраг. Путь к кладу открыт!" } },
    { "id": "s_finale", "locationId": "loc_big_rock", "event": { "type": "finale_lock", "text": "Сундук с сокровищем заперт на замок с тремя цифрами. Введи код с собранной карты." } }
